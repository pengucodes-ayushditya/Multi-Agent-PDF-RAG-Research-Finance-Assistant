MODEL_PROVIDER=ollama
CHAT_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
# PostgreSQL URL must match POSTGRES_PASSWORD below.
DATABASE_URL=postgresql://assistant:change-me-local-only@localhost:55432/assistant
POSTGRES_PASSWORD=change-me-local-only
PDF_COLLECTION=default
MAX_AGENT_TURNS=4
MAX_TOOL_CALLS=8
REQUEST_TIMEOUT=30
# For Groq chat, set MODEL_PROVIDER=groq and CHAT_MODEL=openai/gpt-oss-20b.
GROQ_API_KEY=
# Optional: web search uses DuckDuckGo when this is empty.
TAVILY_API_KEY=
